[
  {
    "id": "S005",
    "text": "국제교류과 사무실이 어디예요?",
    "category": "기타",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S007",
    "text": "숙소 신청 사이트에서 결제가 계속 실패해요. 장학금 들어오면 내려고 했는데 마감이 이번 주예요.",
    "category": "출국준비",
    "urgency": "보통",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S010",
    "text": "파견교 수업이 현지어로만 하는데 영어 수업 목록은 어디서 봐요",
    "category": "학사",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S015",
    "text": "환불 규정 안내문이 있나요",
    "category": "장학비용",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S017",
    "text": "장학금 신청이 내일까지라는데 아직 접수 가능한가요?",
    "category": "장학비용",
    "urgency": "높음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S019",
    "text": "면접 시간을 다른 날로 바꿀 수 있을까요? 시험이랑 겹쳐요.",
    "category": "선발",
    "urgency": "보통",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S020",
    "text": "독감 걸려서 3일째 누워있음. 약은 먹는 중.",
    "category": "안전긴급",
    "urgency": "보통",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S024",
    "text": "가방 통째로 잃어버렸어요. 여권도 거기 있고 내일 아침이 학교 등록 마감인데...",
    "category": "안전긴급",
    "urgency": "높음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S031",
    "text": "성적표가 3주째 안 와요 파견교에 재요청해야 하나요",
    "category": "학사",
    "urgency": "낮음",
    "note": "판단이 갈린다",
    "label_by": "사람"
  },
  {
    "id": "S032",
    "text": "장학금 입금이 계속 늦어지고 있어요",
    "category": "장학비용",
    "urgency": "보통",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S034",
    "text": "귀국 후 학점 인정 신청이 내일까지라는데 맞나요?",
    "category": "학사",
    "urgency": "높음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S040",
    "text": "비자 서류 중에 건강검진서 양식이 두 가지던데 어느 걸 내야 하죠?",
    "category": "출국준비",
    "urgency": "낮음",
    "note": "판단이 갈린다",
    "label_by": "사람"
  },
  {
    "id": "S041",
    "text": "면접 때 영어로 해야 하나요?",
    "category": "선발",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S045",
    "text": "SNS 계정 따로 있어요?",
    "category": "기타",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S046",
    "text": "기숙사 1인실도 신청 가능?",
    "category": "출국준비",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S048",
    "text": "자매대 원서 마감이 오늘 자정인데 지도교수 서명이 안 받아져요",
    "category": "출국준비",
    "urgency": "높음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S050",
    "text": "비자 발급 몇 주 걸리나요?",
    "category": "출국준비",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S051",
    "text": "지난번 안전 교육 자료 다시 보내주세요",
    "category": "기타",
    "urgency": "낮음",
    "note": "판단이 갈린다",
    "label_by": "사람"
  },
  {
    "id": "S053",
    "text": "메일 보냈는데 일주일째 답이 없어요",
    "category": "기타",
    "urgency": "보통",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S054",
    "text": "박지후입니다. 학점 인정 결과가 전공이 아니라 교양으로 들어갔어요. 확인 부탁드립니다.",
    "category": "학사",
    "urgency": "보통",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S056",
    "text": "선발 인원이 몇 명인지 궁금해요",
    "category": "선발",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S060",
    "text": "정이안 학부모입니다. 환불 계좌를 바꾸고 싶어요. 010-5550-0888로 연락 주세요.",
    "category": "장학비용",
    "urgency": "낮음",
    "note": "판단이 갈린다",
    "label_by": "사람"
  },
  {
    "id": "S062",
    "text": "교내 지원서 마감이 오늘 오후 5시인가요? 추천서가 아직 안 올라왔어요.",
    "category": "선발",
    "urgency": "높음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S063",
    "text": "연장하면 장학금도 계속 나오나요?",
    "category": "학사",
    "urgency": "낮음",
    "note": "정답을 미리 봤다",
    "label_by": "사람"
  },
  {
    "id": "S067",
    "text": "현지에서 소매치기가 늘었다고 해서 불안해요. 혼자 다녀도 되는지 봐주세요.",
    "category": "기타",
    "urgency": "낮음",
    "note": "판단이 갈린다",
    "label_by": "사람"
  },
  {
    "id": "S074",
    "text": "대사관 연락처를 어디서 확인하나요",
    "category": "기타",
    "urgency": "낮음",
    "note": "판단이 갈린다",
    "label_by": "사람"
  },
  {
    "id": "S077",
    "text": "홈페이지 오타 발견함. 3페이지에 '교한학생'이라고 돼있음",
    "category": "기타",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S083",
    "text": "지원서 첨부파일 용량이 커서 업로드가 안돼요",
    "category": "선발",
    "urgency": "낮음",
    "note": "판단이 갈린다",
    "label_by": "사람"
  },
  {
    "id": "S085",
    "text": "오늘 오후 3시 설명회 장소가 바뀌었다고 들었는데 어디인가요?",
    "category": "기타",
    "urgency": "높음",
    "note": "",
    "label_by": "사람"
  },
  {
    "id": "S089",
    "text": "등록금은 본교에 내나요 파견교에 내나요",
    "category": "장학비용",
    "urgency": "낮음",
    "note": "",
    "label_by": "사람"
  }
]