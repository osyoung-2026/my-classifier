{
  "1": {
    "id": "S005",
    "칸": "기타",
    "긴급도": "낮음",
    "text": "국제교류과 사무실이 어디예요?"
  },
  "2": {
    "id": "S007",
    "칸": "출국준비",
    "긴급도": "보통",
    "text": "숙소 신청 사이트에서 결제가 계속 실패해요. 장학금 들어오면 내려고 했는데 마감이 이번 주예요."
  },
  "3": {
    "id": "S010",
    "칸": "학사",
    "긴급도": "낮음",
    "text": "파견교 수업이 현지어로만 하는데 영어 수업 목록은 어디서 봐요"
  },
  "4": {
    "id": "S015",
    "칸": "장학비용",
    "긴급도": "낮음",
    "text": "환불 규정 안내문이 있나요"
  },
  "5": {
    "id": "S017",
    "칸": "장학비용",
    "긴급도": "높음",
    "text": "장학금 신청이 내일까지라는데 아직 접수 가능한가요?"
  },
  "6": {
    "id": "S019",
    "칸": "선발",
    "긴급도": "보통",
    "text": "면접 시간을 다른 날로 바꿀 수 있을까요? 시험이랑 겹쳐요."
  },
  "7": {
    "id": "S020",
    "칸": "안전긴급",
    "긴급도": "보통",
    "text": "독감 걸려서 3일째 누워있음. 약은 먹는 중."
  },
  "8": {
    "id": "S024",
    "칸": "안전긴급",
    "긴급도": "높음",
    "text": "가방 통째로 잃어버렸어요. 여권도 거기 있고 내일 아침이 학교 등록 마감인데..."
  },
  "9": {
    "id": "S031",
    "칸": "학사",
    "긴급도": "보통",
    "text": "성적표가 3주째 안 와요 파견교에 재요청해야 하나요"
  },
  "10": {
    "id": "S032",
    "칸": "장학비용",
    "긴급도": "보통",
    "text": "장학금 입금이 계속 늦어지고 있어요"
  },
  "11": {
    "id": "S034",
    "칸": "학사",
    "긴급도": "높음",
    "text": "귀국 후 학점 인정 신청이 내일까지라는데 맞나요?"
  },
  "12": {
    "id": "S040",
    "칸": "출국준비",
    "긴급도": "보통",
    "text": "비자 서류 중에 건강검진서 양식이 두 가지던데 어느 걸 내야 하죠?"
  },
  "13": {
    "id": "S041",
    "칸": "선발",
    "긴급도": "낮음",
    "text": "면접 때 영어로 해야 하나요?"
  },
  "14": {
    "id": "S045",
    "칸": "기타",
    "긴급도": "낮음",
    "text": "SNS 계정 따로 있어요?"
  },
  "15": {
    "id": "S046",
    "칸": "출국준비",
    "긴급도": "낮음",
    "text": "기숙사 1인실도 신청 가능?"
  },
  "16": {
    "id": "S048",
    "칸": "출국준비",
    "긴급도": "높음",
    "text": "자매대 원서 마감이 오늘 자정인데 지도교수 서명이 안 받아져요"
  },
  "17": {
    "id": "S050",
    "칸": "출국준비",
    "긴급도": "낮음",
    "text": "비자 발급 몇 주 걸리나요?"
  },
  "18": {
    "id": "S051",
    "칸": "안전긴급",
    "긴급도": "낮음",
    "text": "지난번 안전 교육 자료 다시 보내주세요"
  },
  "19": {
    "id": "S053",
    "칸": "기타",
    "긴급도": "보통",
    "text": "메일 보냈는데 일주일째 답이 없어요"
  },
  "20": {
    "id": "S054",
    "칸": "학사",
    "긴급도": "보통",
    "text": "박지후입니다. 학점 인정 결과가 전공이 아니라 교양으로 들어갔어요. 확인 부탁드립니다."
  },
  "21": {
    "id": "S056",
    "칸": "선발",
    "긴급도": "낮음",
    "text": "선발 인원이 몇 명인지 궁금해요"
  },
  "22": {
    "id": "S060",
    "칸": "장학비용",
    "긴급도": "보통",
    "text": "정이안 학부모입니다. 환불 계좌를 바꾸고 싶어요. 010-5550-0888로 연락 주세요."
  },
  "23": {
    "id": "S062",
    "칸": "선발",
    "긴급도": "높음",
    "text": "교내 지원서 마감이 오늘 오후 5시인가요? 추천서가 아직 안 올라왔어요."
  },
  "24": {
    "id": "S063",
    "칸": "학사",
    "긴급도": "낮음",
    "text": "연장하면 장학금도 계속 나오나요?"
  },
  "25": {
    "id": "S067",
    "칸": "안전긴급",
    "긴급도": "보통",
    "text": "현지에서 소매치기가 늘었다고 해서 불안해요. 혼자 다녀도 되는지 봐주세요."
  },
  "26": {
    "id": "S074",
    "칸": "안전긴급",
    "긴급도": "낮음",
    "text": "대사관 연락처를 어디서 확인하나요"
  },
  "27": {
    "id": "S077",
    "칸": "기타",
    "긴급도": "낮음",
    "text": "홈페이지 오타 발견함. 3페이지에 '교한학생'이라고 돼있음"
  },
  "28": {
    "id": "S083",
    "칸": "선발",
    "긴급도": "보통",
    "text": "지원서 첨부파일 용량이 커서 업로드가 안돼요"
  },
  "29": {
    "id": "S085",
    "칸": "기타",
    "긴급도": "높음",
    "text": "오늘 오후 3시 설명회 장소가 바뀌었다고 들었는데 어디인가요?"
  },
  "30": {
    "id": "S089",
    "칸": "장학비용",
    "긴급도": "낮음",
    "text": "등록금은 본교에 내나요 파견교에 내나요"
  }
}